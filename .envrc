watch_file CMakePresets.json
python3 "$PWD/scripts/ensure-state-links.py" --quiet || { echo "error: run scripts/ensure-state-links.py --migrate" >&2; exit 1; }
( python3 "$PWD/scripts/store-guard.py" --if-due 3600 >/dev/null 2>&1 & ) 2>/dev/null || true
PATH_add scripts/nix-guard
use flake .#test
PATH_add scripts
