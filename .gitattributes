# Windows batch files must be in CRLF to not make cmd.exe freak out
*.cmd text eol=crlf
*.bat text eol=crlf

# Make sure Windows .lnk shortcuts are binary
*.lnk binary

# Patch files must be checked out in CRLF on Windows for patch to work
*.patch text=auto
*.diff text=auto

# Unified dependency patches encode empty context lines with a space marker.
nix/gpu/*.patch whitespace=-blank-at-eol
