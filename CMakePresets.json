{
  "version": 6,
  "configurePresets": [
    {
      "name": "ios-common",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/packaging/ios/cmake/KritaIOSPlatform.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUILD_WITH_QT6": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{KRITA_IOS_PREFIX_PATH}",
        "CMAKE_FIND_ROOT_PATH": "$env{KRITA_IOS_PREFIX_PATH}",
        "CMAKE_IGNORE_PREFIX_PATH": "/usr/local;/opt/homebrew",
        "KF6_HOST_TOOLING": "$env{KRITA_IOS_KF6_HOST_TOOLING}",
        "Qt6LinguistTools_DIR": "$env{KRITA_IOS_LINGUIST_TOOLS_DIR}",
        "KRITA_IOS_BUILD_PLUGINS": "ON",
        "KRITA_IOS_PLUGIN_KRA": "ON",
        "KRITA_IOS_PLUGIN_PNG": "ON",
        "KRITA_IOS_PLUGIN_JPEG": "ON",
        "KRITA_IOS_PLUGIN_ORA": "ON",
        "KRITA_IOS_PLUGIN_DEFAULT_PAINTOPS": "ON",
        "KRITA_IOS_PLUGIN_EXTENDED_PAINTOPS": "ON",
        "KRITA_IOS_PLUGIN_BASIC_TOOLS": "ON",
        "KRITA_IOS_PLUGIN_LAYER_DOCKER": "ON",
        "KRITA_IOS_PLUGIN_LCMS_ENGINE": "ON",
        "KRITA_IOS_PLUGIN_FILTERS": "ON",
        "KRITA_IOS_PLUGIN_GENERATORS": "ON",
        "KRITA_IOS_PLUGIN_SEEXPR_GENERATOR": "ON",
        "KRITA_IOS_PLUGIN_EXTENDED_IMPEX": "ON",
        "KRITA_IOS_PLUGIN_OPTIONAL_IMPEX": "ON",
        "KRITA_IOS_PLUGIN_EXTENSIONS": "ON",
        "KRITA_IOS_PLUGIN_TOUCH_UI": "ON",
        "KRITA_IOS_PLUGIN_FLAKE": "ON",
        "KRITA_IOS_PLUGIN_METADATA": "ON",
        "KRITA_IOS_PLUGIN_COLORSPACE_EXTENSIONS": "ON"
      }
    },
    {
      "name": "ios-device",
      "displayName": "LibrePaint iOS device",
      "inherits": "ios-common",
      "binaryDir": "${sourceDir}/build-ios/krita/device-ninja",
      "cacheVariables": {
        "KRITA_IOS_PLATFORM": "DEVICE"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "LibrePaint iOS simulator",
      "inherits": "ios-common",
      "binaryDir": "${sourceDir}/build-ios/krita/simulator-ninja",
      "cacheVariables": {
        "KRITA_IOS_PLATFORM": "SIMULATOR"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "targets": ["krita"]
    },
    {
      "name": "ios-simulator",
      "configurePreset": "ios-simulator",
      "targets": ["krita"]
    }
  ]
}
