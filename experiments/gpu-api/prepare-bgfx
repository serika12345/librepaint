// Called between frames after observed completion, for an allocation-policy control.
extern "C" int bgfxExperimentPrivateSource(uint16_t index) {
 auto& texture=s_renderMtl->m_textures[index];auto* old=texture.m_ptr;
 auto* desc=MTL::TextureDescriptor::alloc()->init();
 desc->setTextureType(MTL::TextureType2D);desc->setPixelFormat(old->pixelFormat());
 desc->setWidth(old->width());desc->setHeight(old->height());desc->setDepth(1);
 desc->setMipmapLevelCount(1);desc->setSampleCount(1);desc->setArrayLength(1);
 desc->setStorageMode(MTL::StorageModePrivate);desc->setUsage(MTL::TextureUsageShaderRead);
 auto* replacement=s_renderMtl->m_device->newTexture(desc);desc->release();
 if(!replacement)return 0;
 auto* queue=s_renderMtl->m_device->newCommandQueue();auto* cb=queue->commandBuffer();
 auto* blit=cb->blitCommandEncoder();
 blit->copyFromTexture(old,0,0,MTL::Origin::Make(0,0,0),MTL::Size::Make(old->width(),old->height(),1),replacement,0,0,MTL::Origin::Make(0,0,0));
 blit->endEncoding();cb->commit();cb->waitUntilCompleted();
 bool ok=cb->status()!=MTL::CommandBufferStatusError;queue->release();
 if(!ok){replacement->release();return 0;}
 texture.m_ptr=replacement;old->release();return 1;
}
