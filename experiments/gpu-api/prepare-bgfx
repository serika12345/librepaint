// Experimental completion observation; does not alter rendering commands.
#include <mutex>
#include <condition_variable>
#include <chrono>
static double experimentNow() { return std::chrono::duration<double,std::nano>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
static std::mutex experimentMutex;
static std::condition_variable experimentCV;
static MTL::CommandBuffer* experimentBuffer = nullptr;
static uint32_t experimentFrame = 0;
static double experimentRenderBegin = 0, experimentAcquire = 0, experimentRenderWall = 0;
static void experimentPublish(MTL::CommandBuffer* cb, uint32_t frame) {
 std::lock_guard<std::mutex> lock(experimentMutex);
 if(experimentBuffer) experimentBuffer->release();
 experimentBuffer=cb;cb->retain();experimentFrame=frame;
 experimentRenderWall=experimentNow()-experimentRenderBegin;
 experimentCV.notify_all();
}
extern "C" int bgfxExperimentWait(uint32_t frame, double* gpu, double* renderReady, double* gpuWait, double* renderWall, double* acquire) {
 double start=experimentNow();std::unique_lock<std::mutex> lock(experimentMutex);
 if(!experimentCV.wait_for(lock,std::chrono::seconds(30),[&]{return experimentBuffer && experimentFrame>=frame;})) return 0;
 MTL::CommandBuffer* cb=experimentBuffer;cb->retain();*renderReady=experimentNow()-start;*renderWall=experimentRenderWall;*acquire=experimentAcquire;lock.unlock();
 start=experimentNow();cb->waitUntilCompleted();*gpuWait=experimentNow()-start;
 *gpu=(cb->GPUEndTime()-cb->GPUStartTime())*1e9;
 bool ok=cb->status()!=MTL::CommandBufferStatusError;cb->release();return ok;
}
extern "C" void bgfxExperimentReset() {
 std::lock_guard<std::mutex> lock(experimentMutex);
 if(experimentBuffer) experimentBuffer->release();experimentBuffer=nullptr;experimentFrame=0;
}
'''
