def cpu(xs):return S.median(x['process_cpu_ms']/x['frames'] for x in xs)
def metric(xs,k,stat='median'):return S.median(x['metrics_ms'][k][stat] for x in xs)
def joint(xs):return S.median(S.median((s[2]+s[3])/1e6 for s in x['samples_ns']) for x in xs)
