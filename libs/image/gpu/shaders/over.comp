#version 440
#extension GL_GOOGLE_include_directive : require
#include "rgba.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Base { uint basePixels[]; };
layout(std430, binding = 1) readonly buffer Layer { uint layerPixels[]; };
layout(std430, binding = 2) writeonly buffer Output { uint outputPixels[]; };

void main() {
    uvec2 position = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(position, uvec2(256)))) return;
    uint index = position.y * 256u + position.x;
    uvec4 destination = unpackPixel(basePixels[index]);
    uvec4 source = unpackPixel(layerPixels[index]);
    outputPixels[index] = packPixel(over(destination, source));
}
