    {"id": "masked-erase", "op": "erase", "dst": [20, 60, 100, 192], "src": [255, 0, 0, 128], "opacity": 128, "mask": 128, "expected": [20, 60, 100, 168]},
    {"id": "full-erase-retains-color", "op": "erase", "dst": [20, 60, 100, 192], "src": [255, 0, 0, 255], "opacity": 255, "mask": -1, "expected": [20, 60, 100, 0]}
