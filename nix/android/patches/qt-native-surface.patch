+// SPDX-FileCopyrightText: 2026 LibrePaint contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef QANDROIDPLATFORMNATIVESURFACEWINDOW_H
+#define QANDROIDPLATFORMNATIVESURFACEWINDOW_H
+#include "qandroidplatformwindow.h"
+#include <android/native_window.h>
+QT_BEGIN_NAMESPACE
+class QAndroidPlatformNativeSurfaceWindow : public QAndroidPlatformWindow
+{
+public:
+    explicit QAndroidPlatformNativeSurfaceWindow(QWindow *window);
+    ~QAndroidPlatformNativeSurfaceWindow();
+    QSurfaceFormat format() const override;
+    void setGeometry(const QRect &rect) override;
+    void applicationStateChanged(Qt::ApplicationState state) override;
+    // The caller releases the acquired reference with ANativeWindow_release().
+    ANativeWindow *acquireNativeWindow();
+protected:
+    void clearSurface() override;
+private:
+    void destroyAndClearSurface();
+    ANativeWindow *m_nativeWindow = nullptr;
+};
+QT_END_NAMESPACE
+#endif
