+// SPDX-FileCopyrightText: 2026 LibrePaint contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "qandroidplatformnativesurfacewindow.h"
+#include "androidjnimain.h"
+#include "qandroideventdispatcher.h"
+#include "qandroidplatformscreen.h"
+#include <QSurfaceFormat>
+#include <qpa/qwindowsysteminterface.h>
+#include <android/native_window_jni.h>
+QT_BEGIN_NAMESPACE
+using namespace Qt::StringLiterals;
+QAndroidPlatformNativeSurfaceWindow::QAndroidPlatformNativeSurfaceWindow(QWindow *window)
+    : QAndroidPlatformWindow(window) {}
+QAndroidPlatformNativeSurfaceWindow::~QAndroidPlatformNativeSurfaceWindow()
+{
+    m_surfaceWaitCondition.wakeAll();
+    destroyAndClearSurface();
+}
+QSurfaceFormat QAndroidPlatformNativeSurfaceWindow::format() const
+{
+    return window()->requestedFormat();
+}
+void QAndroidPlatformNativeSurfaceWindow::setGeometry(const QRect &rect)
+{
+    QAndroidPlatformWindow::setGeometry(rect);
+    if (!rect.isEmpty() && !screen()->availableGeometry().isEmpty())
+        QWindowSystemInterface::handleExposeEvent(window(), QRect(QPoint(), rect.size()));
+}
+void QAndroidPlatformNativeSurfaceWindow::applicationStateChanged(Qt::ApplicationState state)
+{
+    if (state <= Qt::ApplicationHidden)
+        destroyAndClearSurface();
+    QAndroidPlatformWindow::applicationStateChanged(state);
+}
+void QAndroidPlatformNativeSurfaceWindow::clearSurface()
+{
+    if (m_nativeWindow) {
+        ANativeWindow_release(m_nativeWindow);
+        m_nativeWindow = nullptr;
+        decrementSurfacesCount();
+    }
+}
+void QAndroidPlatformNativeSurfaceWindow::destroyAndClearSurface()
+{
+    QMutexLocker lock(&m_surfaceMutex);
+    destroySurface();
+    clearSurface();
+}
+ANativeWindow *QAndroidPlatformNativeSurfaceWindow::acquireNativeWindow()
+{
+    if (QAndroidEventDispatcherStopper::stopped() ||
+        QGuiApplication::applicationState() <= Qt::ApplicationHidden)
+        return nullptr;
+    QMutexLocker lock(&m_surfaceMutex);
+    if (!m_androidSurfaceCreated) {
+        QtAndroidPrivate::AndroidDeadlockProtector protector(
+                u"QAndroidPlatformNativeSurfaceWindow::acquireNativeWindow()"_s);
+        if (!protector.acquire())
+            return nullptr;
+        createSurface();
+        m_surfaceWaitCondition.wait(&m_surfaceMutex);
+    }
+    if (!m_androidSurfaceCreated || !m_androidSurfaceObject.isValid())
+        return nullptr;
+    if (!m_nativeWindow) {
+        QJniEnvironment env;
+        m_nativeWindow = ANativeWindow_fromSurface(env.jniEnv(), m_androidSurfaceObject.object());
+        if (!m_nativeWindow)
+            return nullptr;
+        incrementSurfacesCount();
+    }
+    ANativeWindow_acquire(m_nativeWindow);
+    return m_nativeWindow;
+}
+QT_END_NAMESPACE
