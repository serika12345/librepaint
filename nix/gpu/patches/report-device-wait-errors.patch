+#[cfg(test)]
+mod librepaint_device_error_contract {
+    use super::*;
+
+    #[derive(Default)]
+    struct Notice {
+        reason: Option<native::WGPUDeviceLostReason>,
+        error_type: Option<native::WGPUErrorType>,
+        message: String,
+    }
+
+    unsafe extern "C" fn record_loss(
+        _device: *const native::WGPUDevice,
+        reason: native::WGPUDeviceLostReason,
+        message: native::WGPUStringView,
+        userdata1: *mut std::ffi::c_void,
+        _userdata2: *mut std::ffi::c_void,
+    ) {
+        let notice = unsafe { &mut *userdata1.cast::<Notice>() };
+        notice.reason = Some(reason);
+        let bytes = unsafe { std::slice::from_raw_parts(message.data.cast::<u8>(), message.length) };
+        notice.message = std::str::from_utf8(bytes).unwrap().to_owned();
+    }
+
+    unsafe extern "C" fn record_error(
+        _device: *const native::WGPUDevice,
+        error_type: native::WGPUErrorType,
+        message: native::WGPUStringView,
+        userdata1: *mut std::ffi::c_void,
+        _userdata2: *mut std::ffi::c_void,
+    ) {
+        let notice = unsafe { &mut *userdata1.cast::<Notice>() };
+        notice.error_type = Some(error_type);
+        let bytes = unsafe { std::slice::from_raw_parts(message.data.cast::<u8>(), message.length) };
+        notice.message = std::str::from_utf8(bytes).unwrap().to_owned();
+    }
+
+    fn recording_sink(notice: &mut Notice) -> Mutex<ErrorSinkRaw> {
+        let userdata = (notice as *mut Notice).cast();
+        let mut sink = ErrorSinkRaw::new(DeviceLostCallback {
+            callback: Some(record_loss),
+            userdata: utils::Userdata::new(userdata, std::ptr::null_mut()),
+        }, Weak::new());
+        sink.uncaptured_handler = UncapturedErrorCallback {
+            callback: Some(record_error),
+            userdata: utils::Userdata::new(userdata, std::ptr::null_mut()),
+        };
+        Mutex::new(sink)
+    }
+
+    #[test]
+    fn device_loss_reaches_the_client_with_its_cause() {
+        for site in ["wgpuDevicePoll", "WGPUDeviceImpl::drop", "wgpuSurfaceGetCurrentTexture"] {
+            let mut notice = Notice::default();
+            let sink = recording_sink(&mut notice);
+            handle_error(&sink, wgc::device::DeviceError::Lost, None, site);
+            assert_eq!(notice.reason, Some(native::WGPUDeviceLostReason_Unknown));
+            assert!(notice.message.contains(site));
+            assert!(notice.message.contains("Parent device is lost"));
+        }
+    }
+
+    #[test]
+    fn a_surface_error_retains_the_underlying_device_loss() {
+        let mut notice = Notice::default();
+        let sink = recording_sink(&mut notice);
+        handle_error(
+            &sink,
+            wgc::present::SurfaceError::Device(wgc::device::DeviceError::Lost),
+            None,
+            "wgpuSurfaceGetCurrentTexture",
+        );
+        assert_eq!(notice.reason, Some(native::WGPUDeviceLostReason_Unknown));
+        assert!(notice.message.contains("wgpuSurfaceGetCurrentTexture"));
+        assert!(notice.message.contains("Parent device is lost"));
+    }
+    #[test]
+    fn wait_and_submission_errors_keep_device_loss_and_memory_failure_distinct() {
+        for memory_failure in [false, true] {
+            let mut wait_notice = Notice::default();
+            let wait_sink = recording_sink(&mut wait_notice);
+            let mut queue_notice = Notice::default();
+            let queue_sink = recording_sink(&mut queue_notice);
+            let cause = if memory_failure {
+                wgc::device::DeviceError::OutOfMemory
+            } else {
+                wgc::device::DeviceError::Lost
+            };
+            handle_wait_error(&wait_sink, wgc::device::WaitIdleError::Device(cause.clone()), "wgpuDevicePoll");
+            handle_error(&queue_sink, wgc::device::queue::QueueSubmitError::Queue(cause), None, "wgpuQueueSubmit");
+            for notice in [&wait_notice, &queue_notice] {
+                if memory_failure {
+                    assert_eq!(notice.reason, None);
+                    assert_eq!(notice.error_type, Some(native::WGPUErrorType_OutOfMemory));
+                } else {
+                    assert_eq!(notice.reason, Some(native::WGPUDeviceLostReason_Unknown));
+                    assert_eq!(notice.error_type, None);
+                }
+            }
+            assert!(wait_notice.message.contains("wgpuDevicePoll"));
+            assert!(queue_notice.message.contains("wgpuQueueSubmit"));
+        }
+    }
+
+    #[test]
+    fn a_pipeline_internal_error_reaches_the_internal_error_handler() {
+        let mut notice = Notice::default();
+        let sink = recording_sink(&mut notice);
+        handle_error(&sink, wgc::pipeline::CreateComputePipelineError::Internal("compiler failed".into()), None, "wgpuDeviceCreateComputePipeline");
+        assert_eq!(notice.reason, None);
+        assert_eq!(notice.error_type, Some(native::WGPUErrorType_Internal));
+        assert!(notice.message.contains("wgpuDeviceCreateComputePipeline"));
+        assert!(notice.message.contains("compiler failed"));
+    }
+
+}
