Nixpkgs installs the Qt WebEngine locales under the data directory instead of
the translation directory, so the runtime lookup has to use DataPath as well.
This is the nixpkgs locales-path.patch adapted to Qt 6.11.3, which iterates
QLibraryInfo::paths() and no longer concatenates with operator%.

--- a/src/core/api/CMakeLists.txt
+++ b/src/core/api/CMakeLists.txt
@@ -226,7 +226,7 @@
     )
 
 else()
-    set(locale_install_path "${INSTALL_TRANSLATIONSDIR}/qtwebengine_locales")
+    set(locale_install_path "${INSTALL_DATADIR}/qtwebengine_locales")
     install(FILES ${localeFiles}
         DESTINATION ${locale_install_path}
         CONFIGURATIONS ${config}
--- a/src/core/web_engine_library_info.cpp
+++ b/src/core/web_engine_library_info.cpp
@@ -233,7 +233,8 @@
             candidatePaths << getResourcesPath(frameworkBundle()) % QDir::separator()
                             % "qtwebengine_locales"_L1;
 #endif
-            for (auto &p : QLibraryInfo::paths(QLibraryInfo::TranslationsPath))
+            // Nixpkgs: match the changes made in CMakeLists.txt
+            for (auto &p : QLibraryInfo::paths(QLibraryInfo::DataPath))
                 candidatePaths << p % QDir::separator() % "qtwebengine_locales"_L1;
             candidatePaths << fallbackDir();
         }
