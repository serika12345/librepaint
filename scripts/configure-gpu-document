#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Configure GPU document contracts with the source-independent pinned dependency."""
import json
import os
from pathlib import Path
import platform
import subprocess
import sys


def main():
    if len(sys.argv) != 1:
        raise SystemExit("usage: configure-gpu-document")
    if os.environ.get("LIBREPAINT_TEST_SHELL") != "1":
        raise SystemExit("configure-gpu-document requires the cached test development environment")
    presets = {"Darwin": "tdd-macos", "Linux": "tdd-linux"}
    preset = presets.get(platform.system())
    if not preset:
        raise SystemExit("GPU document contracts currently configure on macOS and Linux")
    root = Path(__file__).resolve().parents[1]
    revision = json.loads((root / "flake.lock").read_text())["nodes"]["nixpkgs"]["locked"]["rev"]
    package = f"github:NixOS/nixpkgs/{revision}#wgpu-native"
    # The remote input contains dependencies only; application edits reuse the same output.
    paths = subprocess.run(
        ["nix", "build", "--no-link", "--print-out-paths", package, package + ".dev"],
        check=True, text=True, stdout=subprocess.PIPE,
    ).stdout.splitlines()
    include = next(Path(path) / "include" for path in paths
                   if (Path(path) / "include/webgpu/wgpu.h").is_file())
    library = next(path for output in paths for path in (Path(output) / "lib").glob("libwgpu_native.*")
                   if path.suffix in (".dylib", ".so"))
    subprocess.run([
        "cmake", "--preset", preset, "-DLIBREPAINT_BUILD_GPU_DOCUMENT=ON",
        f"-DLIBREPAINT_WGPU_NATIVE_INCLUDE_DIR={include}",
        f"-DLIBREPAINT_WGPU_NATIVE_LIBRARY={library}",
    ], cwd=root, check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode) from None
