for period in [2,4]:
 CASES[f'wgpu-early-{period}']=dict(CASES['wgpu-direct-widget'],stroke_period=1,brush_period=period)
 CASES[f'wgpu-early-{period}-warm']=dict(CASES['wgpu-dab-warm-direct'],stroke_period=1,brush_period=period)
def dist(values):
 v=sorted(values); return dict(median=statistics.median(v),p95=v[math.ceil(len(v)*.95)-1],min=v[0],max=v[-1])
def summarize(runs):
 result={}
 for w in sorted({r['workload'] for r in runs}):
  for case in sorted({r['case'] for r in runs if r['workload']==w}):
   rr=[r for r in runs if r['workload']==w and r['case']==case]; ss=[s for r in rr for s in r['samples']]
   d={'samples':len(ss),'discarded_inputs':sum(len(r['discarded_inputs']) for r in rr)}
   for key in ['stroke_ms','release_to_frame_ms','dispatch_lateness_ms_max','input_span_ms','process_cpu_ms','gui_cpu_ms']:
    d[key]=dist([s[key] for s in ss])
   d['pipeline_complete_ms']=dist([(max(s['frame_return_ns'],s['document_jobs_done_ns'],s['input_release_ns'])-s['input_begin_ns'])/1e6 for s in ss])
   d['jobs_after_release_ms']=dist([(s['document_jobs_done_ns']-s['input_release_ns'])/1e6 for s in ss])
   d['projection_after_release_ms']=dist([(s['widget_stages']['projection']['finish_ns']-s['input_release_ns'])/1e6 for s in ss])
   d['stages']={}
   for owner in ['widget_stages','window_stages']:
    for stage in sorted({n for s in ss for n in s[owner]}):
     for field,scale in [('total_ns',1e6),('count',1)]:
      d['stages'][owner+'/'+stage+('/cpu_ms' if field=='total_ns' else '/calls')]=dist([s[owner].get(stage,{}).get(field,0)/scale for s in ss])
   if 'uploaded_bytes' in ss[0]:d['uploaded_bytes']=dist([s['uploaded_bytes'] for s in ss])
   result[w+'/'+case]=d
 return result

def main():
 ap=argparse.ArgumentParser(description=__doc__)
 ap.add_argument('--cases',default='opengl,wgpu-raw,wgpu-optimized')
 ap.add_argument('--workloads',default='light,brush,resolution,layers,repaint,pan,stress')
 ap.add_argument('--samples',type=int,default=10); ap.add_argument('--repeat',type=int,default=2)
 ap.add_argument('--gpu-completion',action='store_true')
 ap.add_argument('--cpu-profile',action='store_true')
 ap.add_argument('--threads',type=int,default=8); ap.add_argument('--output',type=Path,default=Path('build/wgpu-bottleneck-experiments.json'))
 a=ap.parse_args(); cases=a.cases.split(','); workloads=a.workloads.split(',')
 if sys.platform!='darwin':ap.error('this prototype measures macOS')
 if set(cases)-CASES.keys() or set(workloads)-WORKLOADS.keys():ap.error('unknown condition')
 root=Path(__file__).resolve().parent.parent
 build=Path(subprocess.check_output([str(root/'scripts/build-incremental'),'native','path'],text=True,cwd=root).strip())
 output=a.output.resolve(); logs=output.parent/(output.stem+'-logs'); logs.mkdir(parents=True,exist_ok=True)
 runs=[]
 source_files=['libs/canvas/wgpu/WgpuImageRenderer.cpp','libs/ui/canvas/wgpu/WgpuCanvasPresenter.cpp','libs/ui/canvas/wgpu/WgpuCanvas.cpp','libs/ui/tests/CanvasPerformanceComparison.cpp','scripts/experiment-wgpu-bottlenecks','libs/canvas/wgpu/WgpuImageRenderer.h','libs/ui/canvas/wgpu/WgpuCanvasPresenter.h','libs/ui/tests/WgpuCanvasIntegrationTest.cpp','libs/ui/canvas/wgpu/WgpuCanvas.h']
 source_files += ['libs/image/KisExperimentCpuProfile.h','libs/image/kis_painter_blt_multi_fixed.cpp','libs/image/kis_painter.cc','libs/image/kis_paint_device.cc','libs/image/tiles3/kis_random_accessor.cc','libs/image/tiles3/kis_tile_data.cc','plugins/paintops/defaultpaintops/brush/KisDabRenderingJob.cpp']
 source_files += ['libs/image/kis_update_job_item.h','plugins/paintops/defaultpaintops/brush/KisDabRenderingQueue.cpp','plugins/paintops/defaultpaintops/brush/KisDabRenderingQueue.h','plugins/paintops/libpaintop/KisDabCacheUtils.cpp','libs/brush/kis_auto_brush.cpp']
 source_files += ['plugins/paintops/defaultpaintops/brush/kis_brushop.cpp','libs/painting/strokes/freehand_stroke.cpp']
 source_hashes={name:hashlib.sha256((root/name).read_bytes()).hexdigest() for name in source_files}
 for name in source_files:
  destination=logs/'source'/name;destination.parent.mkdir(parents=True,exist_ok=True);destination.write_bytes((root/name).read_bytes())
 report=dict(schema=2,repetitions=a.repeat,samples_per_process=a.samples,wgpu_completion_wait='poll_false_50us' if a.gpu_completion else 'none',platform=platform.platform(),gpu_completion_waited=a.gpu_completion,binary_sha256=hashlib.sha256((build/'bin/WgpuCanvasIntegrationTest').read_bytes()).hexdigest(),ui_library_sha256=hashlib.sha256((build/'bin/libkritaapplicationui.21.0.0.dylib').read_bytes()).hexdigest(),scope='CPU return after final projection/upload; process and GUI CPU measured through projection quiet interval; OS display completion unmeasured',workloads={w:dict(WORKLOADS[w],threads=a.threads) for w in workloads},configurations={c:CASES[c] for c in cases},runs=runs)
 report['image_library_sha256']=hashlib.sha256((build/'bin/libkritaimage.21.0.0.dylib').read_bytes()).hexdigest()
 report['brush_module_sha256']=hashlib.sha256((build/'bin/kritadefaultpaintops.so').read_bytes()).hexdigest()
 report['painting_library_sha256']=hashlib.sha256((build/'bin/libkritapainting.21.0.0.dylib').read_bytes()).hexdigest()
 report['cpu_profile']=a.cpu_profile
 report['source_sha256']=source_hashes
 for round_index in range(a.repeat):
  for w in workloads:
   offset=round_index%len(cases)
   for c in cases[offset:]+cases[:offset]:
    config=CASES[c]; env=os.environ.copy();env.pop('MTL_DEBUG_LAYER',None)
    env.update(LIBREPAINT_WGPU_LAYER_REGIONS=str(config.get('layer_regions',0)),LIBREPAINT_WGPU_LATE_LAYER_CAPTURE=str(config.get('late_layer_capture',0)),LIBREPAINT_WGPU_INDIRECT_COMPOSE=str(config.get('gpu_indirect',0)),LIBREPAINT_EXPERIMENT_INPUT_INTERVAL_MS='4',LIBREPAINT_EXPERIMENT_SKIP_CPU_COMPOSE=str(config.get('skip_cpu_compose',0)),LIBREPAINT_WGPU_LAYER_COMPOSE=str(config.get('gpu_layers',0)),LIBREPAINT_WGPU_STAGING_POOL=str(config.get('staging',0)),LIBREPAINT_WGPU_STAGING_MIN_BYTES=str(config.get('staging_min',0)),LIBREPAINT_WGPU_STAGING_BATCH=str(config.get('staging_batch',0)))
    env.update(QT_QPA_PLATFORM='cocoa',KIS_TEST_PREFIX_PATH=str(build),LIBREPAINT_CANVAS_PERFORMANCE=config.get('backend','wgpu'),LIBREPAINT_CANVAS_PERFORMANCE_SAMPLES=str(a.samples),LIBREPAINT_CANVAS_PERFORMANCE_ARTIFACTS=str(logs),LIBREPAINT_WGPU_PRESENT_MODE=config.get('mode','fifo'),LIBREPAINT_WGPU_FRAME_INTERVAL_MS=str(config.get('interval',0)),LIBREPAINT_WGPU_THREADED=str(config.get('thread',0)),LIBREPAINT_WGPU_DIRECT_BGRA=str(config.get('bgra',0)),LIBREPAINT_WGPU_EAGER_PROJECTION=str(config.get('eager',0)),LIBREPAINT_WGPU_BORROW_SNAPSHOT=str(config.get('borrow',0)),LIBREPAINT_WGPU_LATE_UPLOAD=str(config.get('late',0)),LIBREPAINT_WGPU_GPU_PROJECTION=str(config.get('projection',0)),LIBREPAINT_WGPU_COMPOSE_INTERVAL_MS=str(config.get('compose_interval',0)),LIBREPAINT_WGPU_RASTER_UI=str(config.get('raster_ui',0)),LIBREPAINT_WGPU_RAW_PROJECTION=str(config.get('raw_projection',0)),LIBREPAINT_WGPU_SKIP_REDUNDANT=str(config.get('skip_redraw',0)),LIBREPAINT_WGPU_PLAIN_UI=str(config.get('plain_ui',0)),LIBREPAINT_WGPU_FORCE_RASTER=str(config.get('force_raster',0)),LIBREPAINT_WGPU_FRAME_LATENCY=str(config.get('frame_latency',0)),LIBREPAINT_EXPERIMENT_LABEL=f'{round_index+1}-{w}-{c}',LIBREPAINT_EXPERIMENT_STATIC_CACHE=str(config.get('static_cache',0)))
    env['LIBREPAINT_EXPERIMENT_VARY_BRUSH']='0'
    for name,value in WORKLOADS[w].items():env['LIBREPAINT_EXPERIMENT_'+name.upper()]=str(value)
    env['LIBREPAINT_EXPERIMENT_BRUSH_PERIOD_MS']=str(config.get('brush_period',0))
    env['LIBREPAINT_WGPU_DIRECT_WIDGET']=str(config.get('direct_widget',0))
    env['LIBREPAINT_EXPERIMENT_STROKE_PERIOD_MS']=str(config.get('stroke_period',0))
    env['LIBREPAINT_EXPERIMENT_DAB_CACHE']=str(config.get('dab_cache',0))
    env['LIBREPAINT_EXPERIMENT_BRUSH_PACKED']=str(config.get('brush_packed',0))
    env['LIBREPAINT_EXPERIMENT_BRUSH_TILE_ORDER']=str(config.get('brush_tile_order',0))
    env['LIBREPAINT_EXPERIMENT_CPU_PROFILE']=str(int(a.cpu_profile))
    env['LIBREPAINT_EXPERIMENT_THREADS']=str(a.threads)
    env['LIBREPAINT_EXPERIMENT_GPU_COMPLETION']=str(int(a.gpu_completion))
    for key in ['FULL_REPAINT','PAN']:
     env.setdefault('LIBREPAINT_EXPERIMENT_'+key,'0')
    log=logs/f'{round_index+1}-{w}-{c}.log';print(f'round {round_index+1}/{a.repeat} {w}/{c}',flush=True)
    with log.open('w') as stream:
     p=subprocess.run([str(build/'bin/WgpuCanvasIntegrationTest'),'documentProjectionReachesNativeSurface','-maxwarnings','100000'],cwd=root,env=env,stdout=stream,stderr=subprocess.STDOUT,timeout=360)
    if p.returncode:raise RuntimeError(f'failed: {log}')
    for field,name in [('binary_sha256','WgpuCanvasIntegrationTest'),('ui_library_sha256','libkritaapplicationui.21.0.0.dylib'),('image_library_sha256','libkritaimage.21.0.0.dylib'),('brush_module_sha256','kritadefaultpaintops.so'),('painting_library_sha256','libkritapainting.21.0.0.dylib')]:
     if hashlib.sha256((build/'bin'/name).read_bytes()).hexdigest()!=report[field]:raise RuntimeError('benchmark binary changed during measurement')
    lines=[s.partition('CANVAS_PERFORMANCE ')[2] for s in log.read_text().splitlines() if 'CANVAS_PERFORMANCE ' in s]
    if len(lines)!=1:raise RuntimeError(f'report missing: {log}')
    r=json.loads(lines[0])
    if config.get('gpu_layers') and r['display_difference'].get('max_channel_error',255)>2:raise RuntimeError(f'layer composition pixels differ: {log}')
    r.update(case=c,workload=w,round=round_index+1,configuration=config)
    prior=next((r0 for r0 in runs if r0['workload']==w),None)
    if prior and r['pixel_sha256']!=prior['pixel_sha256']:raise RuntimeError(f'brush pixels differ: {log}')
    if prior and r.get('brush_variant_sha256')!=prior.get('brush_variant_sha256'):raise RuntimeError(f'brush variant pixels differ: {log}')
    runs.append(r); report['summary']=summarize(runs);output.write_text(json.dumps(report,indent=2)+'\n')
 print('report:',output)
 for key,s in report['summary'].items():print(key,'complete',s['pipeline_complete_ms'],'tail',s['release_to_frame_ms'],'dispatch',s['dispatch_lateness_ms_max'],'CPU',s['process_cpu_ms'])
if __name__=='__main__':
 try:main()
 except (OSError,RuntimeError,subprocess.SubprocessError) as e:print(e,file=sys.stderr);sys.exit(1)
