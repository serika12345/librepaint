<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for launchd. Replace @REPO@ and @HOME@ before installing; see
     docs/architecture/DEVELOPMENT.md, section "Nix ストアの肥大化の防止". -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.librepaint.store-guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>@REPO@/scripts/store-guard.py</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>LIBREPAINT_STATE_ROOT</key>
        <string>@HOME@/.local/state/librepaint</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/.local/state/librepaint/store-guard.out</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.local/state/librepaint/store-guard.out</string>
</dict>
</plist>
