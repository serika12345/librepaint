{
  "name": "pen-light",
  "description": "Light load: brush outline hover and ink strokes on a blank 2048x1536 RGB canvas at 72 dpi with the default brush.",
  "trajectory": {
    "hover_passes": 8,
    "strokes": 6,
    "speed": 0.5,
    "dwell": 0.3,
    "rate": 240.0,
    "margin": 0.1
  },
  "kritarc": {
    "General": {
      "newOutlineStyle": "2",
      "fpsLimit": "100"
    }
  },
  "runs": 5,
  "warmup_runs": 1,
  "max_runs": 10,
  "rest_seconds": 90,
  "metrics": {
    "hover.input_to_capture": {"regression_ms": 2.0},
    "ink.input_to_capture": {"regression_ms": 2.0}
  }
}
