#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 LibrePaint contributors
# SPDX-License-Identifier: GPL-2.0-or-later

"""Package built desktop libraries and compile external LibrePaint plugins."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


class SdkError(RuntimeError):
    pass


def run(arguments: list[str], **kwargs) -> str:
    result = subprocess.run(arguments, text=True, check=True, stdout=subprocess.PIPE, **kwargs)
    return result.stdout


def cmake_string(value: str) -> str:
    if any(character in value for character in ("\0", "\r", "\n", ";")):
        raise SdkError("CMake SDK values require a single path or argument without list separators")
    return '"' + value.replace("\\", "/").replace('"', '\\"').replace("$", "\\$") + '"'


def cache_values(path: Path) -> dict[str, str]:
    return {
        match[1]: match[2]
        for line in path.read_text().splitlines()
        if (match := re.match(r"([^/#][^:=]*):[^=]+=(.*)", line))
    }


def load_model(build: Path) -> tuple[Path, dict[str, dict]]:
    reply = build / ".cmake/api/v1/reply"
    indices = sorted(reply.glob("index-*.json"))
    if not indices:
        raise SdkError("Configure the application with build-incremental before packaging its SDK")
    index = json.loads(indices[-1].read_text())
    model = json.loads((reply / index["reply"]["codemodel-v2"]["jsonFile"]).read_text())
    if len(model["configurations"]) != 1:
        raise SdkError("SDK packaging requires a single configured build profile")
    targets = {}
    for reference in model["configurations"][0]["targets"]:
        target = json.loads((reply / reference["jsonFile"]).read_text())
        targets[target["name"]] = target
    return Path(model["paths"]["source"]).resolve(), targets


def production_path(path: Path) -> bool:
    return not any(part in {"tests", "test", "benchmarks"} or part.endswith("_autogen") for part in path.parts)


def header_files(root: Path, extra_directories: list[Path]):
    for directory in (root / "libs", root / "3rdparty_vendor", *(root / path for path in extra_directories)):
        if not directory.exists():
            continue
        for path in directory.rglob("*"):
            relative = path.relative_to(root)
            if path.is_file() and production_path(relative) and path.suffix in {".h", ".hh", ".hpp", ".ipp", ".tcc"} and not path.name.endswith("_p.h"):
                yield path, relative
    for path in root.glob("*.h"):
        yield path, path.relative_to(root)
    test_sdk = root / "sdk/tests"
    if test_sdk.exists():
        for path in test_sdk.glob("*.h"):
            yield path, path.relative_to(root)


def package(build: Path, output: Path) -> None:
    build = build.resolve()
    output = output.absolute()
    run(["ninja", "-C", str(build), "build.ninja"])
    source, targets = load_model(build)
    cache = cache_values(build / "CMakeCache.txt")
    system_file = max((build / "CMakeFiles").glob("*/CMakeSystem.cmake"), key=lambda path: path.stat().st_mtime_ns)
    system_text = system_file.read_text()
    system_name = re.search(r'set\(CMAKE_SYSTEM_NAME "([^"]+)"\)', system_text)[1]
    if platform.system() not in {"Darwin", "Linux"} or system_name != platform.system():
        raise SdkError("Desktop SDK packaging currently requires a native macOS or Linux build")
    if output.exists() or output.is_symlink():
        raise SdkError("SDK output already exists; choose a new versioned output directory")
    compiler_text = (system_file.parent / "CMakeCXXCompiler.cmake").read_text()
    implicit_includes = re.search(r'set\(CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES "([^"\n]*)"\)', compiler_text)
    if not implicit_includes:
        raise SdkError("Reconfigure the application to record its compiler include directories")
    compiler_includes = [Path(path) for path in implicit_includes[1].split(";") if path]
    if any(not path.is_relative_to(Path("/nix/store")) for path in compiler_includes):
        raise SdkError("SDK compiler include directories must come from the pinned Nix environment")
    compiler_includes = [path for path in compiler_includes if path.is_dir()]
    libraries = {
        name: target for name, target in targets.items()
        if ((target["type"] == "SHARED_LIBRARY" and
             Path(target["paths"]["source"]).parts[0] in {"libs", "plugins", "qmlmodules"}) or
            (target["type"] == "STATIC_LIBRARY" and target["paths"]["source"].startswith("3rdparty_vendor/"))) and
        production_path(Path(target["paths"]["source"])) and
        not Path(target["paths"]["source"]).is_relative_to(Path("plugins/extensions/pykrita/sip"))
    }
    if not libraries:
        raise SdkError("The configured application contains no shared SDK libraries")
    # Refresh CMake metadata alone. A separate manifest avoids Ninja's dry-run
    # assumption that a glob check always regenerates its own build manifest.
    with tempfile.NamedTemporaryFile(prefix="sdk-plan-", suffix=".ninja", dir=build) as manifest:
        manifest.write((build / "build.ninja").read_bytes())
        manifest.flush()
        plan = run(["ninja", "-f", manifest.name, "-n", "-v", *sorted(libraries)], cwd=build)
    commands = [line for line in plan.splitlines() if re.match(r"\[\d+/\d+\]", line)]
    if commands:
        raise SdkError("SDK libraries or generated headers require rebuilding. Run build-incremental native build before packaging")
    artifacts = {}
    for name, target in libraries.items():
        paths = target.get("artifacts", [])
        if len(paths) != 1:
            raise SdkError(f"Expected one native shared library for {name}")
        path = (build / paths[0]["path"]).resolve()
        if not path.is_file():
            raise SdkError(f"Build the application library {name} before packaging its SDK")
        artifacts[path] = name
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".librepaint-sdk-", dir=output.parent) as temporary:
        root = Path(temporary) / "sdk"
        root.mkdir()
        config = root / "lib/cmake/LibrePaintSDK"
        config.mkdir(parents=True)
        lib = root / "lib"
        for path in artifacts:
            shutil.copy2(path, lib / path.name)
            (lib / path.name).chmod(0o755)
        if platform.system() == "Darwin":
            native_names = {}
            for original in artifacts:
                if libraries[artifacts[original]]["type"] == "SHARED_LIBRARY":
                    identifier = run(["otool", "-D", str(original)]).splitlines()[1].strip()
                    native_names[identifier] = "@rpath/" + Path(identifier).name
                    alias = lib / Path(identifier).name
                    if alias.name != original.name:
                        alias.symlink_to(original.name)
            for original in artifacts:
                if libraries[artifacts[original]]["type"] != "SHARED_LIBRARY":
                    continue
                binary = lib / original.name
                identifier = run(["otool", "-D", str(original)]).splitlines()[1].strip()
                changes = ["install_name_tool", "-id", native_names[identifier]]
                dependencies = run(["otool", "-L", str(binary)]).splitlines()[1:]
                for line in dependencies:
                    dependency = line.strip().split(" (compatibility version", 1)[0]
                    resolved = Path(dependency).resolve() if dependency.startswith("/") else None
                    if dependency in native_names:
                        changes.extend(["-change", dependency, native_names[dependency]])
                    elif resolved in artifacts:
                        target_id = run(["otool", "-D", str(resolved)]).splitlines()[1].strip()
                        changes.extend(["-change", dependency, native_names[target_id]])
                rpaths = re.findall(r"cmd LC_RPATH\s+cmdsize \d+\s+path (.+) \(offset \d+\)", run(["otool", "-l", str(binary)]))
                for rpath in rpaths:
                    if rpath.startswith((str(build), str(source))):
                        changes.extend(["-delete_rpath", rpath])
                if "@loader_path" not in rpaths:
                    changes.extend(["-add_rpath", "@loader_path"])
                run([*changes, str(binary)])
        else:
            if not shutil.which("patchelf"):
                raise SdkError("SDK relocation requires patchelf in the pinned SDK environment")
            for path in artifacts:
                if libraries[artifacts[path]]["type"] != "SHARED_LIBRARY":
                    continue
                soname = run(["patchelf", "--print-soname", str(path)]).strip()
                if soname and soname != path.name:
                    (lib / soname).symlink_to(path.name)
                run(["patchelf", "--set-rpath", "$ORIGIN:" + ":".join(
                    value for value in run(["patchelf", "--print-rpath", str(path)]).strip().split(":")
                    if value.startswith("/nix/store/")), str(lib / path.name)])
        extra_headers = [Path(target["paths"]["source"]) for target in libraries.values()
                         if not target["paths"]["source"].startswith(("libs/", "3rdparty_vendor/"))]
        for owner, prefix in ((source, "source"), (build, "generated")):
            for path, relative in header_files(owner, extra_headers):
                destination = root / "include" / prefix / relative
                destination.parent.mkdir(parents=True, exist_ok=True)
                data = path.read_bytes()
                if relative == Path("KoConfig.h"):
                    data = re.sub(rb'#define KRITA_BUILD_DIR "[^"\n]*"', b'#define KRITA_BUILD_DIR ""', data)
                elif relative == Path("KoTestConfig.h"):
                    data = ("#include <KoConfig.h>\n"
                            "#define KRITA_SOURCE_DIR LIBREPAINT_SDK_TEST_SOURCE_DIR\n"
                            "#define KRITA_RESOURCE_DIRS_FOR_TESTS LIBREPAINT_SDK_TEST_RESOURCE_DIR\n"
                            "#define KRITA_PLUGINS_DIR_FOR_TESTS LIBREPAINT_SDK_TEST_PLUGIN_DIR\n").encode()
                destination.write_bytes(data)

        def mapped_path(path: Path) -> str:
            # Resolve the build tree first because it normally lives within the source tree.
            for owner, prefix in ((build, "generated"), (source, "source")):
                if path.is_relative_to(owner):
                    relative = path.relative_to(owner)
                    if not production_path(relative) and relative != Path("sdk/tests"):
                        return ""
                    destination = root / "include" / prefix / relative
                    destination.mkdir(parents=True, exist_ok=True)
                    return "${_librepaint_sdk_root}/include/" + prefix + "/" + relative.as_posix()
            if not path.is_relative_to(Path("/nix/store")):
                raise SdkError("SDK dependencies must come from the pinned Nix environment")
            return str(path)

        def sdk_string(value: str) -> str:
            return cmake_string(value).replace("\\${_librepaint_sdk_root}", "${_librepaint_sdk_root}")

        def sdk_list(values: list[str]) -> str:
            return '"' + ";".join(sdk_string(value)[1:-1] for value in values) + '"'

        target_lines = ['get_filename_component(_librepaint_sdk_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)']
        for name, target in sorted(libraries.items()):
            original = next(path for path, owner in artifacts.items() if owner == name)
            groups = [group for group in target.get("compileGroups", []) if group["language"] == "CXX"]
            if not groups:
                groups = target.get("compileGroups", [])
            includes, defines, options, links = [str(path) for path in compiler_includes], [], ["-fno-operator-names"], []
            for group in groups:
                includes.extend(filter(None, (mapped_path(Path(item["path"]).resolve()) for item in group.get("includes", []))))
                defines.extend(item["define"] for item in group.get("defines", [])
                               if not item["define"].endswith("_EXPORTS") and
                               not item["define"].startswith(("XSIMD_IMPL=", "CMAKE_INSTALL_PREFIX=")))
                for framework in group.get("frameworks", []):
                    options.append("-F" + str(Path(framework["path"]).parent))
            for fragment in target.get("link", {}).get("commandFragments", []):
                if fragment["role"] != "libraries":
                    continue
                tokens = shlex.split(fragment["fragment"])
                cursor = 0
                while cursor < len(tokens):
                    token = tokens[cursor]
                    cursor += 1
                    if token.startswith("-Wl,-rpath,"):
                        continue
                    if token == "-framework":
                        token += " " + tokens[cursor]
                        cursor += 1
                    candidate = (build / token).resolve()
                    if candidate in artifacts:
                        token = artifacts[candidate]
                    elif not token.startswith("-") and not Path(token).is_relative_to(Path("/nix/store")):
                        raise SdkError(f"SDK library {name} has a non-pinned link dependency")
                    links.append(token)
            target_lines.extend([
                f"add_library({name} {'SHARED' if target['type'] == 'SHARED_LIBRARY' else 'STATIC'} IMPORTED)",
                f"set_target_properties({name} PROPERTIES",
                "  IMPORTED_LOCATION " + sdk_string("${_librepaint_sdk_root}/lib/" + original.name),
                "  INTERFACE_INCLUDE_DIRECTORIES " + sdk_list(list(dict.fromkeys(includes))),
                "  INTERFACE_COMPILE_DEFINITIONS " + sdk_list(list(dict.fromkeys(defines))),
                "  INTERFACE_COMPILE_OPTIONS " + sdk_list(list(dict.fromkeys(options))),
                "  INTERFACE_LINK_LIBRARIES " + sdk_list(links),
                ")",
            ])
        (config / "LibrePaintSDKTargets.cmake").write_text("\n".join(target_lines) + "\n")
        qt_config = Path(cache["Qt6Core_DIR"])
        qt_version_file = qt_config / "Qt6CoreConfigVersionImpl.cmake"
        if not qt_version_file.exists():
            qt_version_file = qt_config / "Qt6CoreConfigVersion.cmake"
        qt_match = re.search(r'set\(PACKAGE_VERSION "([^"]+)"\)', qt_version_file.read_text())
        if not qt_match:
            raise SdkError("Cannot determine the pinned Qt version")
        processor_match = re.search(r'set\(CMAKE_SYSTEM_PROCESSOR "([^"]+)"\)', system_text)
        profile = {
            "SYSTEM": platform.system(),
            "PROCESSOR": processor_match[1],
            "CXX_COMPILER": cache["CMAKE_CXX_COMPILER"],
            "QT_VERSION": qt_match[1],
            "VERSION": re.search(r'#define LIBREPAINT_VERSION_STRING "([^"]+)"',
                                 (build / "libs/version/kritaversion.h").read_text())[1],
        }
        (config / "LibrePaintSDKProfile.cmake").write_text("\n".join(
            f"set(LibrePaintSDK_{key} {cmake_string(value)})" for key, value in profile.items()) + "\n")
        toolchain_keys = ("CMAKE_C_COMPILER", "CMAKE_CXX_COMPILER", "CMAKE_OSX_ARCHITECTURES", "CMAKE_OSX_DEPLOYMENT_TARGET", "CMAKE_OSX_SYSROOT")
        toolchain_lines = [f"set({key} {cmake_string(cache[key])} CACHE STRING \"SDK build profile\")" for key in toolchain_keys if cache.get(key)]
        toolchain_lines.extend(f"set({key} {cmake_string(value)} CACHE PATH \"SDK dependency\")" for key, value in sorted(cache.items()) if key.endswith("_DIR") and value.startswith("/nix/store/") and not value.endswith("NOTFOUND"))
        (config / "LibrePaintSDKToolchain.cmake").write_text("\n".join(toolchain_lines) + "\n")
        tooling = Path(os.environ.get("LIBREPAINT_SDK_DATA", Path(__file__).resolve().parents[1]))
        shutil.copy2(tooling / "sdk/cmake/LibrePaintSDKConfig.cmake", config)
        for module in ("KritaAddBrokenUnitTest.cmake", "KritaTestSuite.cmake"):
            shutil.copy2(tooling / "cmake/modules" / module, config)
        for license_file in source.glob("COPYING*"):
            if license_file.is_file():
                shutil.copy2(license_file, root / license_file.name)
        for relative in (Path("sdk/tests/data"), Path("krita/data")):
            shutil.copytree(source / relative, root / "share" / relative)
        notices = root / "share/licenses"
        for license_file in (source / "3rdparty_vendor").rglob("COPYING*"):
            if license_file.is_file():
                destination = notices / license_file.relative_to(source)
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(license_file, destination)
        (config / "LibrePaintSDKConfigVersion.cmake").write_text(
            f"set(PACKAGE_VERSION {cmake_string(profile['VERSION'])})\n"
            "set(PACKAGE_VERSION_COMPATIBLE FALSE)\n"
            "if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)\n"
            "  set(PACKAGE_VERSION_COMPATIBLE TRUE)\n"
            "  set(PACKAGE_VERSION_EXACT TRUE)\n"
            "endif()\n")
        manifest = {
            "schemaVersion": 1,
            "profile": profile,
            "libraries": sorted(libraries),
            "files": {path.relative_to(root).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
                      for path in sorted(root.rglob("*")) if path.is_file()},
        }
        manifest["packageId"] = hashlib.sha256(json.dumps(manifest, sort_keys=True).encode()).hexdigest()
        (root / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        if output.exists() or output.is_symlink():
            raise SdkError("SDK output already exists; choose a new versioned output directory")
        os.rename(root, output)
    print(f"Packaged {len(libraries)} built libraries: {output}")


def checked_manifest(sdk: Path) -> dict:
    manifest = json.loads((sdk / "manifest.json").read_text())
    if manifest.get("schemaVersion") != 1:
        raise SdkError("Unsupported SDK manifest; select the SDK matching the application")
    for relative, expected in manifest["files"].items():
        path = sdk / relative
        if not path.resolve().is_relative_to(sdk) or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise SdkError("The SDK contents changed; repackage it from the matching built application")
    return manifest


def build_plugin(sdk: Path, source: Path, build: Path, output: Path, project: bool = False) -> None:
    sdk, source, build = (path.resolve() for path in (sdk, source, build))
    output = Path(os.path.abspath(output))
    manifest = checked_manifest(sdk)
    if output.exists() or output.is_symlink():
        raise SdkError("Plugin output already exists; choose a separate output directory")
    config = sdk / "lib/cmake/LibrePaintSDK"
    query = build / ".cmake/api/v1/query"
    query.mkdir(parents=True, exist_ok=True)
    (query / "codemodel-v2").touch()
    if not project:
        wrapper = build / ".librepaint-plugin-project"
        wrapper.mkdir(parents=True, exist_ok=True)
        wrapper_file = wrapper / "CMakeLists.txt"
        marker = "# Generated by LibrePaint plugin-sdk\n"
        if wrapper_file.exists() and not wrapper_file.read_text().startswith(marker):
            raise SdkError("Plugin build directory contains another project's sources; choose a new build directory")
        wrapper_file.write_text(
            marker + "cmake_minimum_required(VERSION 3.25)\n"
            "project(LibrePaintExternalPlugin LANGUAGES C CXX)\n"
            "find_package(LibrePaintSDK REQUIRED CONFIG)\n"
            f"add_subdirectory({cmake_string(str(source))} plugin)\n")
        source = wrapper
    subprocess.run(["cmake", "-S", str(source), "-B", str(build), "-G", "Ninja",
                    "-DCMAKE_BUILD_TYPE=Release", "-DLibrePaintSDK_DIR=" + str(config),
                    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                    "-DCMAKE_TOOLCHAIN_FILE=" + str(config / "LibrePaintSDKToolchain.cmake"),
                    "-DCMAKE_INSTALL_PREFIX=" + str(output)], check=True)
    _, plugin_targets = load_model(build)
    modules = sorted(name for name, target in plugin_targets.items()
                     if target["type"] == "MODULE_LIBRARY" and production_path(Path(target["paths"]["source"])))
    if not modules:
        raise SdkError("The selected source defines no desktop plugin module")
    subprocess.run(["cmake", "--build", str(build), "--parallel", "2", "--target", *modules], check=True)
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".librepaint-plugin-", dir=output.parent) as temporary:
        stage = Path(temporary)
        subprocess.run(["cmake", "--install", str(build)], check=True, env=os.environ | {"DESTDIR": str(stage)})
        installed = stage / output.relative_to(output.anchor)
        files = [path for path in stage.rglob("*") if path.is_file()]
        if not files or any(not path.resolve().is_relative_to(installed) for path in files):
            raise SdkError("Plugin installation must place its artifacts below the selected output prefix")
        record = {"schemaVersion": 1, "sdk": manifest["packageId"],
                  "files": {path.relative_to(installed).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
                            for path in sorted(files)}}
        (installed / "librepaint-plugin.json").write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
        if output.exists() or output.is_symlink():
            raise SdkError("Plugin output already exists; choose a separate output directory")
        os.rename(installed, output)


def check_plugin(sdk: Path, output: Path) -> None:
    sdk, output = sdk.resolve(), output.resolve()
    manifest = checked_manifest(sdk)
    record = json.loads((output / "librepaint-plugin.json").read_text())
    if record.get("schemaVersion") != 1 or record.get("sdk") != manifest["packageId"]:
        raise SdkError("The plugin targets another SDK. Rebuild with plugin-sdk build --sdk <matching-sdk> --source <plugin-source> --build <new-build> --output <new-output>")
    for relative, expected in record["files"].items():
        path = output / relative
        if not path.resolve().is_relative_to(output) or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise SdkError("The plugin output changed after building; rebuild it into a new output directory")
    print("Plugin artifacts match the selected SDK")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    package_parser = commands.add_parser("package")
    package_parser.add_argument("--build", required=True, type=Path)
    package_parser.add_argument("--output", required=True, type=Path)
    build_parser = commands.add_parser("build")
    for key in ("sdk", "source", "build", "output"):
        build_parser.add_argument("--" + key, required=True, type=Path)
    build_parser.add_argument("--project", action="store_true", help="source is a standalone CMake project using find_package(LibrePaintSDK)")
    check_parser = commands.add_parser("check")
    for key in ("sdk", "output"):
        check_parser.add_argument("--" + key, required=True, type=Path)
    arguments = parser.parse_args()
    try:
        if arguments.command == "package":
            package(arguments.build, arguments.output)
        elif arguments.command == "build":
            build_plugin(arguments.sdk, arguments.source, arguments.build, arguments.output, arguments.project)
        else:
            check_plugin(arguments.sdk, arguments.output)
    except (SdkError, OSError, ValueError, KeyError, StopIteration, subprocess.CalledProcessError) as error:
        print(f"plugin-sdk: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
