#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python3 "$repo_root/scripts/check-store-hygiene.py"

if [[ "${LIBREPAINT_TEST_SHELL:-}" != "1" ]]; then
    echo "verify must run inside: nix develop .#test" >&2
    exit 1
fi

./scripts/verify-quick

case "$(uname -s)" in
    Darwin)
        preset="tdd-macos"
        ;;
    Linux)
        preset="tdd-linux"
        ;;
    *)
        echo "unsupported native test host: $(uname -s)" >&2
        exit 1
        ;;
esac

./scripts/build-incremental native build
# An empty CTEST_PARALLEL_LEVEL runs one test per processor (CMake 3.29+);
# a number limits it on machines with less memory.
export CTEST_PARALLEL_LEVEL="${CTEST_PARALLEL_LEVEL-}"
ctest --preset "$preset"

echo "verify: OK"
