#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 LibrePaint contributors
# SPDX-License-Identifier: GPL-2.0-or-later

"""Rebuild existing plugins with a packaged SDK and exercise a GPU pixel exchange."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import runpy
import shutil
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def run(arguments: list[str], log: Path, **kwargs) -> None:
    with log.open("w") as output:
        result = subprocess.run(arguments, stdout=output, stderr=subprocess.STDOUT, text=True, **kwargs)
    if result.returncode:
        print(log.read_text())
        raise RuntimeError(f"SDK verification failed: {log.name}")


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build", required=True, type=Path)
    parser.add_argument("--work", type=Path)
    arguments = parser.parse_args()
    build = arguments.build.resolve()
    work = arguments.work.resolve() if arguments.work else Path(tempfile.mkdtemp(prefix="librepaint-sdk-contract-"))
    if work.is_relative_to(ROOT) or work.is_relative_to(build):
        raise RuntimeError("SDK verification uses a work directory outside the application source and build trees")
    if work.exists() and any(work.iterdir()):
        raise RuntimeError("SDK verification needs a new or empty work directory")
    work.mkdir(parents=True, exist_ok=True)
    sdk_tool = runpy.run_path(str(ROOT / "scripts/plugin-sdk"))
    _, targets = sdk_tool["load_model"](build)
    application_libraries = [
        (build / artifact["path"]).resolve()
        for target in targets.values()
        if target["type"] == "SHARED_LIBRARY" and sdk_tool["production_path"](Path(target["paths"]["source"]))
        for artifact in target.get("artifacts", [])
    ]
    before = {str(path): (path.stat().st_mtime_ns, digest(path)) for path in application_libraries}
    sdk = work / "sdk"
    run([str(ROOT / "scripts/plugin-sdk"), "package", "--build", str(build), "--output", str(sdk)], work / "package.log")
    for header in (sdk / "include").rglob("*.h"):
        data = header.read_bytes()
        if str(ROOT).encode() in data or str(build).encode() in data:
            raise RuntimeError(f"SDK header still references the original source or build tree: {header.name}")
    for category, relative in (
        ("filter", "plugins/filters/roundcorners"),
        ("brush", "plugins/paintops/roundmarker"),
        ("format", "plugins/impex/tga"),
        ("extension", "plugins/extensions/offsetimage"),
    ):
        source = work / category / "source"
        shutil.copytree(ROOT / relative, source)
        original = {path.relative_to(source).as_posix(): digest(path) for path in source.rglob("*") if path.is_file()}
        run([str(ROOT / "scripts/plugin-sdk"), "build", "--sdk", str(sdk), "--source", str(source),
             "--build", str(work / category / "build"), "--output", str(work / category / "output")], work / f"{category}-build.log")
        if any(digest(source / relative) != expected for relative, expected in original.items()):
            raise RuntimeError(f"Rebuilding modified the {category} plugin sources")
        commands = json.loads((work / category / "build/compile_commands.json").read_text())
        if any(str(ROOT) in entry["command"] or str(build) in entry["command"] for entry in commands):
            raise RuntimeError(f"The {category} plugin still depends on the application's source or build tree")
        run([str(ROOT / "scripts/plugin-sdk"), "check", "--sdk", str(sdk), "--output", str(work / category / "output")], work / f"{category}-check.log")
        print(f"Unchanged {category} plugin rebuilt with the standalone SDK", flush=True)
    contract_source = work / "contract/source"
    shutil.copytree(ROOT / "sdk/contracts/filter", contract_source)
    config = sdk / "lib/cmake/LibrePaintSDK"
    contract_build = work / "contract/build"
    run(["cmake", "-S", str(contract_source), "-B", str(contract_build), "-G", "Ninja",
         "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DLibrePaintSDK_DIR=" + str(config),
         "-DCMAKE_TOOLCHAIN_FILE=" + str(config / "LibrePaintSDKToolchain.cmake")], work / "contract-configure.log")
    run(["cmake", "--build", str(contract_build), "--parallel", "2"], work / "contract-build.log")
    plugin = work / "filter/output/lib/librepaint/plugins/kritaroundcornersfilter.so"
    environment = os.environ | {
        "QT_QPA_PLATFORM": "cocoa" if platform.system() == "Darwin" else "xcb",
        "KIS_TEST_PREFIX_PATH": str(sdk),
        "KRITA_PLUGIN_PATH": str(plugin.parent),
        "LIBREPAINT_EXTERNAL_FILTER": str(plugin),
    }
    environment["DYLD_PRINT_LIBRARIES" if platform.system() == "Darwin" else "LD_DEBUG"] = "1" if platform.system() == "Darwin" else "libs"
    run(["ctest", "--test-dir", str(contract_build), "--output-on-failure", "-V"], work / "contract-test.log", env=environment)
    if str(build / "bin") in (work / "contract-test.log").read_text():
        raise RuntimeError("SDK runtime still loads libraries from the original application build")
    edited_source = work / "filter/source/kis_round_corners_filter.cpp"
    edited_source.write_bytes(edited_source.read_bytes() + b"\n")
    edited_output = work / "filter/output-edited"
    run([str(ROOT / "scripts/plugin-sdk"), "build", "--sdk", str(sdk), "--source", str(edited_source.parent),
         "--build", str(work / "filter/build"), "--output", str(edited_output)], work / "filter-edited-build.log")
    run([str(ROOT / "scripts/plugin-sdk"), "check", "--sdk", str(sdk), "--output", str(edited_output)], work / "filter-edited-check.log")
    after = {str(path): (path.stat().st_mtime_ns, digest(path)) for path in application_libraries}
    if before != after:
        raise RuntimeError("Plugin rebuilding changed the built application libraries")
    print(f"GPU pixel exchange and unified Undo/Redo passed; application libraries stayed unchanged. Evidence: {work}")


if __name__ == "__main__":
    main()
