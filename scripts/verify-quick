#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ "${LIBREPAINT_TEST_SHELL:-}" != "1" ]]; then
    echo "verify-quick must run inside: nix develop .#test" >&2
    exit 1
fi

python3 -m unittest discover -s scripts/tests -p 'test_*.py'
python3 scripts/architecture/update_public_header_inventory.py --check
python3 scripts/architecture/check_public_surface_inventory.py
python3 scripts/check_governance.py

shellcheck \
    packaging/ios/scripts/build-librepaint-incremental.sh \
    scripts/build-incremental \
    scripts/platform/* \
    scripts/verify-quick \
    scripts/verify \
    scripts/run-test \
    scripts/docs/*.sh

bash scripts/docs/check-architecture.sh

echo "verify-quick: OK"
