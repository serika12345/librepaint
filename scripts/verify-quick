#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ "${LIBREPAINT_TEST_SHELL:-}" != "1" ]]; then
    echo "verify-quick must run inside: nix develop .#test" >&2
    exit 1
fi

python3 -m unittest discover -s scripts/tests -p 'test_*.py'
python3 scripts/architecture/check_package_boundaries.py
python3 scripts/architecture/check_public_contracts.py

echo "verify-quick: OK"
